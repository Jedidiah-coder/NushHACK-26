SUPABASE_URL=https://supabaseprojectlinkhere.supabase.co
SUPABASE_KEY=secret_key
FLASK_SECRET_KEY=random_string

# Optional: the number shown on the SOS screen until an admin saves one in Settings.
SOS_PHONE_NUMBER=

# Optional: automatic SOS texts through Twilio. They stay off until all four are filled in.
# The Account SID starts with AC, the API key SID starts with SK, and the number looks like +15551234567.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_FROM_NUMBER=
